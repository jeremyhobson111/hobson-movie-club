# List every environment variable the project needs. Names and descriptions only, never real values.
# EXAMPLE_API_URL=   # base URL of the API

# Supabase Edge Function secrets. Set in the Supabase dashboard (Edge Functions > Secrets), never in a file.
TMDB_READ_TOKEN=          # TMDB "API Read Access Token", used by the tmdb function
PLEX_WEBHOOK_SECRET=      # random string in the Plex webhook address, protects the plex-webhook function
VAPID_PUBLIC_KEY=         # public half of the push key pair (also written in js/push.js)
VAPID_PRIVATE_KEY=        # private half of the push key pair: secret, never share
VAPID_SUBJECT=            # mailto: address used when sending push messages
# Seerr (Supabase Edge Function secrets): is a movie on Plex?
SEERR_URL=
SEERR_API_KEY=
